<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>

        <!-- dotnet tool packaging -->
        <PackAsTool>true</PackAsTool>
        <ToolCommandName>nuget-licenses</ToolCommandName>
        <PackageId>Horstmeier.NugetLicenses</PackageId>
        <Authors>Jens Horstmeier</Authors>
        <Description>Check NuGet package licenses against a permitted list</Description>
        <PackageProjectUrl>https://github.com/horstmeier/NugetLicenses</PackageProjectUrl>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
    </PropertyGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="Horstmeier.NugetLicenses.Tests"/>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.3"/>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.3"/>
        <PackageReference Include="MinVer" Version="6.1.0">
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="NuGet.Protocol" Version="7.3.0"/>
        <PackageReference Include="System.CommandLine" Version="2.0.3"/>
    </ItemGroup>

    <PropertyGroup>
        <!-- MinVer configuration -->
        <MinVerMinimumMajorMinor>0.1</MinVerMinimumMajorMinor>
    </PropertyGroup>


</Project>
